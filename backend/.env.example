# Database (Render free PostgreSQL — copy the External Database URL from the Render dashboard)
DATABASE_URL=postgresql://user:password@host:5432/hoverai

# JWT — generate a strong random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Intron Sahara STT
# Your hackathon access token (from the registration email) IS this value.
# "Access token" and "API key" mean the same thing — it goes in Authorization: Bearer <value>
INTRON_API_KEY=your-intron-hackathon-access-token
INTRON_STT_BASE_URL=https://infer.voice.intron.io

# Groq — free tier
# Get your key at: https://console.groq.com
GROQ_API_KEY=your-groq-key

# HuggingFace — free Inference API
# Get your token at: https://huggingface.co/settings/tokens
HF_API_KEY=your-huggingface-token

# Model names (change here to swap models without touching code)
VISION_MODEL=qwen/qwen3.8-27b
WHISPER_MODEL=whisper-large-v3
HF_ASR_MODEL=openai/whisper-large-v3

# TTS — Groq Orpheus (English voices: autumn | diana | hannah | austin | daniel | troy)
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=autumn
TTS_ENABLED=true

# TTS — Sahara (Intron) — African language voices
# When SAHARA_TTS_ENABLED=true, African-language requests (en-pidgin, yo, ha, ig)
# are synthesised using Sahara TTS for an authentic voice.
# Groq Orpheus is used as fallback if Sahara fails, and for en/fr.
# Uses the same INTRON_API_KEY as Sahara STT — no extra key needed.
SAHARA_TTS_ENABLED=true

# Sahara polling behaviour
SAHARA_POLL_INTERVAL_S=2.0
SAHARA_POLL_TIMEOUT_S=120.0

# ── Local Ollama two-step pipeline (optional) ────────────────────────────────
# ⚠️  WARNING: setting LOCAL_LLM_BASE_URL adds 5-30s latency per request.
#    The local pipeline runs moondream (caption) → qwen2.5:3b (JSON) serially.
#    Leave it BLANK for the fast path: Groq handles vision in a single ~2-5s call.
#
# Only set this if you have a second PC running Ollama with moondream + qwen2.5:3b:
#   ollama pull moondream && ollama pull qwen2.5:3b
#   OLLAMA_KEEP_ALIVE=-1 OLLAMA_HOST=0.0.0.0 ollama serve
#   ngrok http 11434
#
# Groq is the automatic fallback if either local step times out or fails.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=ollama
# Step 1 — captioning model (must support images, no JSON required)
LOCAL_VISION_MODEL=moondream
LOCAL_VISION_TIMEOUT=60.0
# Step 2 — reasoning model (text only, must follow JSON schema)
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_TIMEOUT=90.0
