{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HoverAI",
  "version": "0.1.0",
  "identifier": "com.hoverai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HoverAI",
        "width": 1200,
        "height": 800,
        "resizable": false,
        "visible": true,
        "decorations": true
      },
      {
        "label": "overlay",
        "title": "HoverAI Overlay",
        "url": "overlay.html",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": true,
        "focus": false
      },
      {
        "label": "settings",
        "title": "HoverAI Settings",
        "url": "settings.html",
        "width": 480,
        "height": 680,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
